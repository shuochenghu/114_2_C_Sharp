using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Cell_Phone_Test
{
    // CellPhone類別 - 代表一個手機物件
    class CellPhone
    {
        // 私有欄位：儲存手機品牌
        private string _brand;
        // 私有欄位：儲存手機型號
        private string _model;
        // 私有欄位：儲存手機價格
        private decimal _price;

        // 建構式：初始化手機物件的屬性
        public CellPhone() 
        {
            _brand = "";
            _model = "";
            _price = 0.0m;
        }

        // 品牌屬性 - 取得或設定手機品牌
        public string Brand 
        {
            get { return _brand; }
            set { _brand = value; }
        }

        // 型號屬性 - 取得或設定手機型號
        public string Model 
        {
            get { return _model; }
            set { _model = value; }
        }

        // 價格屬性 - 取得或設定手機價格
        public decimal Price 
        {
            get { return _price; }
            set { _price = value; }
        }
    }
}
