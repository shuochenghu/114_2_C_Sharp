using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Telephone_Format
{
    /// <summary>
    /// Form1 類別 - 電話號碼格式化應用程式的主要表單
    /// 功能：接受用戶輸入的10位數字，將其格式化為(XXX) XXX-XXXX的電話號碼格式
    /// </summary>
    public partial class Form1 : Form
    {
        // 表單構造函式
        public Form1()
        {
            InitializeComponent();
        }

        // IsValidNumber方法接受一個字串參數
        // 檢查字串是否包含恰好10個數字
        // 如果是10個數字則返回true，否則返回false
        private bool IsValidNumber(string str)
        {
            // 檢查字串是否為空或長度不為10
            if (str == null || str.Length != 10)
                return false;

            // 逐一檢查字串中的每個字元
            // 確保所有字元都是數字(0-9)
            foreach (char c in str)
            {
                if (!char.IsDigit(c))
                    return false;
            }

            // 所有字元都是數字，返回true
            return true;
        }

        // TelephoneFormat方法以引用方式接受一個字串參數
        // 將字串格式化為電話號碼格式：(XXX) XXX-XXXX
        // 例如：1234567890 -> (123) 456-7890
        private void TelephoneFormat(ref string str)
        {
            // 使用字串的Substring方法提取各部分
            // 第一部分：前3位數字(區碼)
            string part1 = str.Substring(0, 3);
            // 第二部分：中間3位數字
            string part2 = str.Substring(3, 3);
            // 第三部分：最後4位數字
            string part3 = str.Substring(6, 4);

            // 將各部分組合成電話號碼格式
            str = "(" + part1 + ") " + part2 + "-" + part3;
        }

        // 格式化按鈕的點擊事件處理方法
        private void formatButton_Click(object sender, EventArgs e)
        {
            // 從文字框中獲取用戶輸入的內容
            string number = numberTextBox.Text;

            // 驗證輸入的內容是否為有效的10位數字
            if (!IsValidNumber(number))
            {
                // 如果輸入無效，顯示錯誤訊息給用戶
                MessageBox.Show("請輸入10個數字。", "輸入錯誤");
                // 清空文字框，讓用戶重新輸入
                numberTextBox.Clear();
                // 將焦點設回文字框
                numberTextBox.Focus();
            }
            else
            {
                // 如果輸入有效，調用TelephoneFormat方法格式化電話號碼
                // 以引用方式傳遞字串，使其在方法內被修改
                TelephoneFormat(ref number);
                // 將格式化後的電話號碼顯示在文字框中
                numberTextBox.Text = number;
            }
        }

        // 結束按鈕的點擊事件處理方法
        private void exitButton_Click(object sender, EventArgs e)
        {
            // 關閉表單，結束應用程式
            this.Close();
        }
    }
}
